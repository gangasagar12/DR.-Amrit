<IfModule mod_rewrite.c>
    RewriteEngine On

    # Stop processing if file or directory exists
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else to index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>

Options -Indexes
