# Application Environment (use 'production' for live VPS)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# MySQL Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dental_doctor_db
DB_USER=dental_user
DB_PASS=YourStrongPasswordHere

# Session Settings (in seconds: 31536000 = 1 year persistent login)
SESSION_LIFETIME=31536000

